# 서버
PORT=3000
NODE_ENV=development

# DB (DB 팀 제공값으로 교체)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=culturepath
# 스키마 변경(ALTER 등) 권한이 있는 별도 계정이 있으면 지정. 없으면 DB_USER/DB_PASSWORD 사용.
# scripts/migrate.js (npm run migrate) 에서만 쓰인다.
# DB_MIGRATION_USER=migrator
# DB_MIGRATION_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 로그인/회원가입 rate limit (IP 기준, 브루트포스·대량 가입 스팸 방지)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=600000
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=5

# 공공데이터 API (실제 키는 .env에만 저장)
TOUR_API_KEY=your_tour_api_key_here
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# TourAPI - 영문 서비스 (EngService2, 국문과 별도 인증키/일일 트래픽 1000건)
TOUR_API_ENG_KEY=your_tour_api_eng_key_here
# TourAPI - 일문 서비스 (JpnService2, 일일 트래픽 1000건)
TOUR_API_JPN_KEY=your_tour_api_jpn_key_here
# TourAPI - 중문 간체 서비스 (ChsService2, 일일 트래픽 1000건)
TOUR_API_CHS_KEY=your_tour_api_chs_key_here
RELATED_TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
RELATED_TOUR_BASE_YM=202503
DATALAB_API_BASE_URL=https://apis.data.go.kr/B551011/DataLabService
DATALAB_REFERENCE_YMD=20210513
PUBLIC_DATA_MOBILE_OS=ETC
PUBLIC_DATA_MOBILE_APP=CulturePath
EXTERNAL_API_TIMEOUT_MS=8000
EXTERNAL_API_MAX_RETRIES=1
EXTERNAL_API_RETRY_DELAY_MS=200

# 장소 캐시 (초 단위)
PLACE_CACHE_ENABLED=true
PLACE_CACHE_TTL_SECONDS=86400
PLACE_CACHE_STALE_MAX_AGE_SECONDS=604800
PLACE_CACHE_DB_FAILURE_COOLDOWN_SECONDS=30

# DataLab 방문자 캐시 (초 단위)
DATALAB_CACHE_ENABLED=true
DATALAB_CACHE_TTL_SECONDS=604800
DATALAB_CACHE_STALE_MAX_AGE_SECONDS=2592000
DATALAB_CACHE_DB_FAILURE_COOLDOWN_SECONDS=30
DATALAB_COMPARE_DAYS=7

# AI 여행 도우미 (실제 키는 .env에만 저장)
USE_MOCK_AI=true
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=3
AI_SESSION_TTL_SECONDS=1800
AI_SESSION_MAX_SESSIONS=1000

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MAX_OUTPUT_TOKENS=1600
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
OPENROUTER_EMBEDDING_DIMENSIONS=1024
OPENROUTER_TIMEOUT_MS=15000
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CulturePath

# 아래 Qdrant/RAG 값은 decay 스크립트와 과거 평가 호환용이며 제출 전 활성 경로에서는
# 사용하지 않습니다. 새 환경에서는 비워 두어도 됩니다.
USE_MOCK_RAG=true
RAG_API_URL=http://localhost:8000
RAG_TOP_K=8
RAG_MIN_RESULTS=3
QDRANT_URL=your_qdrant_cluster_url_here
# Qdrant Cloud 등 인증이 필요한 배포에서만 입력합니다.
QDRANT_API_KEY=
QDRANT_COLLECTION=culturepath_places_v1
QDRANT_TIMEOUT_MS=8000
# R8 live 평가 후 확정합니다. 비어 있으면 최소 점수를 적용하지 않습니다.
QDRANT_SCORE_THRESHOLD=
RAG_INDEX_BATCH_SIZE=32
RAG_INDEX_PAGE_SIZE=200
